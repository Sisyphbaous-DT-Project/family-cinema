new file mode 100644
index 0000000..d790afa
--- /dev/null
+++ b/android_dns.go
@@ -0,0 +1,28 @@
+package main
+
+import (
+	"context"
+	"net"
+	"os"
+	"time"
+)
+
+// 安卓机顶盒没有 /etc/resolv.conf，Go 自带的解析器找不到 DNS 服务器；
+// 这种情况下改用公共 DNS（与 media-server 的 dns.go 同一套）。
+func init() {
+	if _, err := os.Stat("/etc/resolv.conf"); err == nil {
+		return
+	}
+	net.DefaultResolver = &net.Resolver{
+		PreferGo: true,
+		Dial: func(ctx context.Context, network, address string) (net.Conn, error) {
+			d := &net.Dialer{Timeout: 4 * time.Second}
+			for _, s := range []string{"223.5.5.5:53", "119.29.29.29:53", "114.114.114.114:53"} {
+				if c, err := d.DialContext(ctx, "udp", s); err == nil {
+					return c, nil
+				}
+			}
+			return d.DialContext(ctx, network, address)
+		},
+	}
+}
